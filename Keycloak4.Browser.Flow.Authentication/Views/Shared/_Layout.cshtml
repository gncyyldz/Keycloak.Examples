<a asp-action="Index" asp-controller="Home">Index</a> | <a asp-action="Detail" asp-controller="Home">Detail</a>

@ViewBag.Title

<h1>'@Context.User.Identity?.Name' giriş yaptı...</h1>

@RenderBody()

@if (!Context.User.Identity.IsAuthenticated)
{
    <a asp-action="Login" asp-controller="Account">Giriş Yap</a>
}
else
{
    <a asp-action="Logout" asp-controller="Account">Çıkış yap</a>
}